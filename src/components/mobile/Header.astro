---
import BrandMark from '../shared/BrandMark.astro';
import { config } from '../../config.js';
const brandName = config.site.name;
---
<div class="header">
  <a class="brand" href="/">
    <BrandMark size={40} />
    <div class="brand-title serif">{brandName}</div>
  </a>
  <div class="header-actions">
    <a class="header-search" href="/search" aria-label="搜索" title="搜索">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
      </svg>
    </a>
    <button class="hamburger" data-drawer-open aria-label="menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</div>
