---
import { postUrl, tagUrl } from '../../lib/urls.js';
import { getDailyQuote } from '../../lib/quotes.js';
import { config } from '../../config.js';

interface Props {
  posts: any[];
  /** 无 hero 的页面传 true：右栏撑到一屏高、组件贴屏幕底部 */
  bottomAlign?: boolean;
}
const { posts, bottomAlign = false } = Astro.props;

const recent = posts ? posts.slice(0, 4) : [];
const allTags = posts ? [...new Set(posts.flatMap((p) => p.tags))].slice(0, 12) : [];

const { quote, index: quoteIndex } = getDailyQuote();
---
<aside class={'pc-rail' + (bottomAlign ? ' pc-rail-bottom' : '')}>
  <div class="pc-search">
    <input type="text" placeholder="文章寻踪（输入后回车）" data-rail-search />
  </div>

  <div class="pc-widget">
    <div class="pc-widget-head">流年拾忆</div>
    <ul class="pc-recent">
      {recent.map((p) => (
        <li><a href={postUrl(p)}>{p.title}</a></li>
      ))}
    </ul>
  </div>

  <div class="pc-widget">
    <div class="pc-widget-head">文踪墨迹</div>
    <div class="pc-tags">
      {allTags.map((t) => (
        <a class="pc-tag" href={tagUrl(t)}>{t}</a>
      ))}
    </div>
  </div>

  <div class="pc-widget" data-quote-widget data-quote-index={quoteIndex}>
    <div class="pc-widget-head">
      时光只言
      <button class="pc-quote-next" type="button" data-quote-next aria-label="换一条格言" title="换一条">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
          <path d="M21 3v6h-6"/>
        </svg>
      </button>
    </div>
    <figure class="pc-quote">
      <blockquote class="pc-quote-text" data-quote-text>{quote.text}</blockquote>
      {quote.author && <figcaption class="pc-quote-author" data-quote-author>{quote.author}</figcaption>}
    </figure>
    <script type="application/json" data-quote-list set:html={JSON.stringify(config.quotes)} />
  </div>
</aside>

<script>import '../../scripts/quote.js';</script>
