---
import Analytics from '@vercel/analytics/astro';
import { config } from '../config.js';
// 自托管字体（woff2 子集，font-display: swap），不依赖 Google Fonts。
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/jetbrains-mono/400.css';

interface Props {
  /** 页面名（不含站点名）：最终标题统一为「{page} · 无忧乡」；留空则用站点名 */
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, any>;
}
const {
  title,
  description = config.site.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  jsonLd,
} = Astro.props;

// 标题模板的唯一出口：{page} · {站点名}。
const pageTitle = title ? `${title} · ${config.site.name}` : config.site.name;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 文章有图片封面时优先使用，否则回退到站点默认分享图（1200×630）。
const useDefaultOgImage = !image;
const ogImage = new URL(image || config.site.ogImage, Astro.site).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={config.site.name} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={pageTitle} />
  {useDefaultOgImage && <meta property="og:image:width" content="1200" />}
  {useDefaultOgImage && <meta property="og:image:height" content="630" />}
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {type === 'article' && tags && tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={pageTitle} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={config.site.name} href="/rss.xml" />
  <link rel="stylesheet" href="/styles/pc.css">
  <link rel="stylesheet" href="/styles/mobile.css">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <style is:global define:vars={config.theme}>
    :root {
      --pc-accent:      var(--accent);
      --pc-side:        var(--sidebar);
      --pc-bg:          var(--bgLight);
      --bg:             var(--bgLight);
      --drawer:         var(--sidebar);
    }
    body              { background: var(--bgLight); }
    .dark body        { background: var(--bgDark); }
    .dark .pc         { --pc-bg: var(--bgDark); }
    .dark             { --bg: var(--bgDark); }
    /* 主题切换图标：明亮模式显示月亮，暗色模式显示太阳 */
    .theme-icon-dark            { display: none; }
    .dark .theme-icon-dark      { display: block; }
    .dark .theme-icon-light     { display: none; }
    /* 点赞高亮：填充爱心 */
    .pc-article-like.liked svg,
    .article-like.liked svg     { fill: #fff; }
  </style>
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <slot />
  <Analytics />
  <script>import '../scripts/global.js';</script>
</body>
</html>
